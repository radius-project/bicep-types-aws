    "definitions": {
      "AuthenticationStatus": {
        "additionalProperties": false,
        "description": "The authentication status of the cluster peer relationship in ONTAP.",
        "properties": {
          "InUse": {
            "description": "The authentication method in use, for example ok.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "State": {
            "description": "The authentication state, for example ok.",
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "Tag": {
        "additionalProperties": false,
        "description": "A key-value pair used to tag the cluster peer relationship.",
        "properties": {
          "Key": {
            "description": "The tag key.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$",
            "type": "string"
