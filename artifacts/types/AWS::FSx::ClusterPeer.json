          "fsx:DescribeClusterPeers",
          "fsx:UpdateClusterPeer",
          "fsx:TagResource",
          "fsx:UntagResource"
        ]
      }
    },
    "primaryIdentifier": [
      "/properties/ResourceARN"
    ],
    "properties": {
      "AllowedSvmIds": {
        "description": "The local SVMs the peer cluster may peer with automatically, when AllowedSvmMode is SPECIFIED.",
        "insertionOrder": false,
        "items": {
          "description": "The ID of a local SVM.",
          "maxLength": 21,
          "minLength": 21,
          "pattern": "^(svm-[0-9a-f]{17,})$",
          "type": "string"
        },
        "maxItems": 24,
        "type": "array",
        "uniqueItems": true
      },
      "AllowedSvmMode": {
        "description": "Which local SVMs the peer cluster may peer with automatically: ALL, NONE, or SPECIFIED (the SVMs in AllowedSvmIds).",
        "enum": [
          "ALL",
          "NONE",
          "SPECIFIED"
        ],
        "type": "string"
      },
      "AuthenticationStatus": {
        "$ref": "#/definitions/AuthenticationStatus"
      },
      "ClusterPeerId": {
        "description": "The system-generated, unique ID of the cluster peer relationship.",
        "pattern": "^(clusterpeer-[0-9a-f]{17})$",
        "type": "string"
      },
      "FileSystemId": {
        "description": "The ID of the local file system.",
        "maxLength": 21,
        "minLength": 11,
        "pattern": "^(fs-[0-9a-f]{8,})$",
        "type": "string"
      },
      "Lifecycle": {
        "description": "The lifecycle status of the cluster peer relationship.",
        "enum": [
          "CREATING",
          "CREATED",
          "DELETING",
          "FAILED"
        ],
        "type": "string"
      },
      "PassphraseSecretArn": {
        "description": "The ARN of an AWS Secrets Manager secret whose plain-text value is the cluster peering passphrase. Required when you create the cluster peer. Both sides of the relationship must use the same passphrase. The secret must allow FSx to read it.",
        "maxLength": 1024,
        "minLength": 64,
        "pattern": "^arn:[^:]{1,63}:secretsmanager:[a-z0-9-]+:[0-9]{12}:secret:[a-zA-Z0-9/_+=.@-]+-[a-zA-Z0-9]{6}$",
        "type": "string"
      },
      "PeerAddresses": {
        "description": "The intercluster IP addresses of the peer cluster, at least one.",
        "insertionOrder": false,
        "items": {
          "maxLength": 45,
          "minLength": 1,
          "pattern": "(^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]))$|^(([0-9a-fA-F]{1,4}:){7,7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$)",
          "type": "string"
        },
        "maxItems": 24,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "PeerClusterName": {
        "description": "The ONTAP name of the peer cluster. After it is set, it can be changed but not removed; removing it from the template leaves the current name.",
        "maxLength": 44,
        "minLength": 1,
        "pattern": "^[^\\u0000\\u0085\\u2028\\u2029\\r\\n]{1,44}$",
        "type": "string"
      },
      "ResourceARN": {
        "description": "The Amazon Resource Name (ARN) of the cluster peer relationship.",
        "maxLength": 512,
        "minLength": 8,
        "pattern": "^arn:(?=[^:]+:fsx:[^:]+:\\d{12}:)((|(?=[a-z0-9-.]{1,63})(?!\\d{1,3}(\\.\\d{1,3}){3})(?![^:]*-{2})(?![^:]*-\\.)(?![^:]*\\.-)[a-z0-9].*(?\u003c!-)):){4}(?!/).{0,1024}$",
        "type": "string"
      },
      "Status": {
        "description": "The ONTAP availability of the peer relationship, for example available or unavailable.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "Tags": {
        "description": "A list of tags to apply to the cluster peer relationship, with a maximum of 50 tags.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/Tag"
        },
        "maxItems": 50,
        "type": "array",
        "uniqueItems": false
      },
      "UUID": {
        "description": "The ONTAP UUID of the cluster peer relationship.",
        "maxLength": 36,
        "pattern": "^[^\\u0000\\u0085\\u2028\\u2029\\r\\n]{1,36}$",
        "type": "string"
      }
    },
    "readOnlyProperties": [
