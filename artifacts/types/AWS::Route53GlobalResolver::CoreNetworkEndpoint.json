          "route53globalresolver:GetCoreNetworkEndpoint",
          "route53globalresolver:TagResource",
          "route53globalresolver:UntagResource",
          "route53globalresolver:ListTagsForResource"
        ],
        "timeoutInMinutes": 120
      }
    },
    "primaryIdentifier": [
      "/properties/CoreNetworkEndpointId"
    ],
    "properties": {
      "Arn": {
        "description": "The Amazon Resource Name (ARN) of the core network endpoint.",
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "AvailableRegions": {
        "description": "Regions where the endpoint can serve DNS: the Global Resolver regions that are also core network edge locations.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/Region"
        },
        "type": "array"
      },
      "ClientToken": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "CoreNetworkArn": {
        "description": "The ARN of the AWS Cloud WAN core network to connect. The core network must be in the same account and AVAILABLE. A core network can have one core network endpoint.",
        "maxLength": 2048,
        "minLength": 1,
        "pattern": "^arn:[-.a-z0-9]{1,63}:[-.a-z0-9]{1,63}:[-.a-z0-9]{0,63}:[-.a-z0-9]{0,63}:[^/].{0,1023}$",
        "type": "string"
      },
      "CoreNetworkEndpointId": {
        "description": "The ID of the core network endpoint.",
        "maxLength": 64,
        "minLength": 1,
