{
  "arn": "arn:aws:cloudformation:us-west-2::type/resource/AWS-Route53GlobalResolver-CoreNetworkEndpoint",
  "type": "AWS::Route53GlobalResolver::CoreNetworkEndpoint",
  "time": "2026-11-18T00:07:40.987Z",
  "schema": {
    "additionalIdentifiers": [
