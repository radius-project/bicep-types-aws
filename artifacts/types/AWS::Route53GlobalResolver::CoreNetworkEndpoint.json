          "route53globalresolver:GetCoreNetworkEndpoint"
        ],
        "timeoutInMinutes": 70
      },
      "list": {
        "permissions": [
          "route53globalresolver:ListCoreNetworkEndpoints"
        ]
      },
      "read": {
        "permissions": [
          "route53globalresolver:GetCoreNetworkEndpoint",
          "route53globalresolver:ListTagsForResource"
        ]
      },
      "update": {
        "permissions": [
