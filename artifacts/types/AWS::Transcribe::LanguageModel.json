            "minLength": 20,
            "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso-{0,1}[a-z]{0,1}):iam::[0-9]{0,63}:role/[A-Za-z0-9:_/+=,@.-]{0,1024}$",
            "type": "string"
          },
          "S3Uri": {
            "description": "The Amazon S3 location (URI) of the text files used to train your custom language model.",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "^(s3://|http(s*)://).+$",
            "type": "string"
          },
          "TuningDataS3Uri": {
            "description": "The Amazon S3 location (URI) of the text files used to tune your custom language model.",
            "maxLength": 2000,
            "minLength": 1,
            "pattern": "^(s3://|http(s*)://).+$",
            "type": "string"
          }
        },
        "required": [
          "S3Uri",
          "DataAccessRoleArn"
        ],
        "type": "object"
      },
      "Tag": {
        "additionalProperties": false,
        "description": "A key-value pair to associate with the custom language model.",
        "properties": {
          "Key": {
            "description": "The key of the tag.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
