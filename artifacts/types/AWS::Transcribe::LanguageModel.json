        "permissions": [
          "transcribe:ListLanguageModels"
        ]
      },
      "read": {
        "permissions": [
          "transcribe:DescribeLanguageModel",
          "transcribe:ListTagsForResource"
        ]
      }
    },
    "primaryIdentifier": [
      "/properties/Arn"
    ],
    "properties": {
      "Arn": {
        "description": "The Amazon Resource Name (ARN) of the custom language model.",
        "maxLength": 1011,
        "minLength": 1,
        "pattern": "^arn:(aws|aws-cn|aws-us-gov|aws-iso-{0,1}[a-z]{0,1}):transcribe:[a-z0-9-]+:[0-9]{12}:language-model/[0-9a-zA-Z._-]+$",
        "type": "string"
      },
      "BaseModelName": {
        "description": "The Amazon Transcribe standard language model, or base model, used to create your custom language model.",
        "enum": [
          "NarrowBand",
          "WideBand"
        ],
        "type": "string"
      },
      "CreateTime": {
        "description": "The date and time the custom language model was created.",
        "format": "date-time",
        "type": "string"
      },
      "InputDataConfig": {
        "$ref": "#/definitions/InputDataConfig"
      },
      "LanguageCode": {
        "description": "The language code that represents the language of your model.",
        "enum": [
          "en-US",
          "hi-IN",
          "es-US",
          "en-GB",
          "en-AU",
          "de-DE",
          "ja-JP"
        ],
        "type": "string"
      },
      "LastModifiedTime": {
        "description": "The date and time the custom language model was last modified.",
        "format": "date-time",
        "type": "string"
      },
      "ModelName": {
        "description": "The name of the custom language model.",
