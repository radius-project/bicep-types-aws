      },
      "ModelStatus": {
        "description": "The status of the custom language model.",
        "enum": [
          "IN_PROGRESS",
          "FAILED",
          "COMPLETED"
        ],
        "type": "string"
      },
      "Tags": {
        "description": "Tags associated with the custom language model.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/Tag"
        },
        "maxItems": 200,
        "type": "array",
