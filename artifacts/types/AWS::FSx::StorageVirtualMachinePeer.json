        "description": "A key-value pair used to tag the SVM peer relationship.",
        "properties": {
          "Key": {
            "description": "The tag key.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$",
            "type": "string"
          },
          "Value": {
            "description": "The tag value.",
            "maxLength": 256,
