{
  "arn": "arn:aws:cloudformation:us-west-2::type/resource/AWS-MediaConvert-CertificateAssociation",
  "type": "AWS::MediaConvert::CertificateAssociation",
  "time": "2026-11-05T21:15:04.339Z",
  "schema": {
    "additionalProperties": false,
    "createOnlyProperties": [
      "/properties/Arn"
    ],
    "description": "Associates an AWS Certificate Manager (ACM) certificate with AWS Elemental MediaConvert to enable encryption for content delivery.",
    "handlers": {
      "create": {
        "permissions": [
          "mediaconvert:AssociateCertificate",
          "acm:DescribeCertificate",
          "acm:SearchCertificates"
        ]
      },
      "delete": {
        "permissions": [
          "mediaconvert:DisassociateCertificate",
          "acm:DescribeCertificate"
        ]
      },
      "list": {
        "permissions": [
          "acm:ListCertificates"
        ]
      },
      "read": {
        "permissions": [
          "acm:DescribeCertificate"
        ]
      }
    },
    "primaryIdentifier": [
      "/properties/Arn"
    ],
    "properties": {
      "Arn": {
        "description": "The ARN of the ACM certificate to associate with MediaConvert.",
        "maxLength": 2048,
        "minLength": 20,
        "pattern": "^arn:aws(-[a-z]+)*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-f0-9-]+$",
        "type": "string"
      }
    },
    "required": [
      "Arn"
    ],
    "tagging": {
      "taggable": false
    },
    "typeName": "AWS::MediaConvert::CertificateAssociation"
  }
}