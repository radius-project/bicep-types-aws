        "fsx:UntagResource"
      ],
      "tagOnCreate": true,
      "tagProperty": "/properties/Tags",
      "tagUpdatable": true,
      "taggable": true
    },
    "typeName": "AWS::FSx::SnapshotPolicy"
  }
