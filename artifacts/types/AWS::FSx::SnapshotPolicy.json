{
  "arn": "arn:aws:cloudformation:us-west-2::type/resource/AWS-FSx-SnapshotPolicy",
  "type": "AWS::FSx::SnapshotPolicy",
  "time": "2026-11-21T19:53:26.834Z",
  "schema": {
    "additionalIdentifiers": [
      [
        "/properties/SnapshotPolicyId"
      ]
    ],
    "additionalProperties": false,
    "createOnlyProperties": [
      "/properties/FileSystemId",
      "/properties/StorageVirtualMachineId",
      "/properties/Name",
      "/properties/Schedules"
    ],
    "definitions": {
      "SnapshotPolicyRetentionPeriod": {
        "additionalProperties": false,
        "description": "How long to retain snapshots created by a schedule.",
        "properties": {
          "Type": {
            "description": "The unit of the retention period, or INFINITE to retain snapshots indefinitely.",
            "enum": [
              "SECONDS",
              "MINUTES",
              "HOURS",
              "DAYS",
              "MONTHS",
              "YEARS",
              "INFINITE"
            ],
            "type": "string"
          },
          "Value": {
            "description": "The length of the retention period, in the unit given by Type.",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "Type"
        ],
        "type": "object"
      },
      "SnapshotPolicySchedule": {
        "additionalProperties": false,
        "description": "A schedule within a snapshot policy.",
        "properties": {
          "Count": {
            "description": "The maximum number of snapshots to retain for this schedule.",
            "maximum": 1023,
            "minimum": 0,
            "type": "integer"
          },
          "Name": {
            "description": "The name of the ONTAP job schedule that triggers snapshot creation, for example hourly, daily, or weekly.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "Prefix": {
            "description": "The prefix applied to the names of snapshots created by this schedule.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "RetentionPeriod": {
            "$ref": "#/definitions/SnapshotPolicyRetentionPeriod"
          },
          "SnapmirrorLabel": {
            "description": "The SnapMirror label applied to snapshots created by this schedule. SnapMirror policies use this label to select snapshots to replicate.",
            "maxLength": 31,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "Name",
          "Count"
        ],
        "type": "object"
      },
      "Tag": {
        "additionalProperties": false,
        "description": "A key-value pair used to tag the snapshot policy.",
        "properties": {
          "Key": {
            "description": "The tag key.",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$",
            "type": "string"
          },
          "Value": {
            "description": "The tag value.",
            "maxLength": 256,
            "minLength": 0,
            "pattern": "^([\\p{L}\\p{Z}\\p{N}_.:/=+\\-@]*)$",
            "type": "string"
          }
        },
        "required": [
          "Key",
          "Value"
        ],
        "type": "object"
      }
    },
    "description": "Creates an Amazon FSx for NetApp ONTAP snapshot policy. A snapshot policy defines up to five schedules that automatically create and retain volume snapshots. A snapshot policy is scoped either to a file system or to a storage virtual machine (SVM).",
    "handlers": {
      "create": {
        "permissions": [
          "fsx:CreateSnapshotPolicy",
          "fsx:DescribeSnapshotPolicies",
          "fsx:TagResource"
        ]
      },
      "delete": {
        "permissions": [
          "fsx:DeleteSnapshotPolicy",
          "fsx:DescribeSnapshotPolicies"
        ]
      },
      "list": {
        "permissions": [
          "fsx:DescribeSnapshotPolicies"
        ]
      },
      "read": {
        "permissions": [
          "fsx:DescribeSnapshotPolicies",
          "fsx:ListTagsForResource"
        ]
      },
      "update": {
        "permissions": [
          "fsx:DescribeSnapshotPolicies",
          "fsx:UpdateSnapshotPolicy",
          "fsx:TagResource",
          "fsx:UntagResource"
        ]
      }
    },
    "oneOf": [
      {
        "required": [
          "FileSystemId"
        ]
      },
      {
        "required": [
          "StorageVirtualMachineId"
        ]
      }
    ],
    "primaryIdentifier": [
      "/properties/ResourceARN"
    ],
    "properties": {
      "Enabled": {
        "description": "Whether the snapshot policy is enabled. A disabled policy doesn't create snapshots. If you remove this property from the template, a stack update keeps the current value.",
        "type": "boolean"
      },
      "FileSystemId": {
        "description": "The ID of the FSx for ONTAP file system on which to create a file system-scoped snapshot policy. Specify exactly one of FileSystemId or StorageVirtualMachineId.",
        "maxLength": 21,
        "minLength": 11,
        "pattern": "^(fs-[0-9a-f]{8,})$",
        "type": "string"
      },
      "Lifecycle": {
        "description": "The lifecycle status of the snapshot policy.",
        "enum": [
          "CREATING",
          "CREATED",
          "DELETING",
          "FAILED"
        ],
        "type": "string"
      },
      "Name": {
        "description": "The name of the snapshot policy.",
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
      },
      "ResourceARN": {
        "description": "The Amazon Resource Name (ARN) of the snapshot policy.",
        "maxLength": 512,
        "minLength": 8,
        "pattern": "^arn:(?=[^:]+:fsx:[^:]+:\\d{12}:)((|(?=[a-z0-9-.]{1,63})(?!\\d{1,3}(\\.\\d{1,3}){3})(?![^:]*-{2})(?![^:]*-\\.)(?![^:]*\\.-)[a-z0-9].*(?\u003c!-)):){4}(?!/).{0,1024}$",
        "type": "string"
      },
      "Schedules": {
        "description": "The schedules of the snapshot policy. Each schedule creates snapshots on a named ONTAP job schedule and retains a maximum number of them.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/SnapshotPolicySchedule"
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array",
        "uniqueItems": false
      },
      "Scope": {
        "description": "Whether the snapshot policy is scoped to a file system or to an SVM.",
        "enum": [
          "FILESYSTEM",
          "SVM"
        ],
        "type": "string"
      },
      "SnapshotPolicyId": {
        "description": "The system-generated, unique ID of the snapshot policy.",
        "maxLength": 29,
        "minLength": 29,
        "pattern": "^snapshotpol-[0-9a-f]{17}$",
        "type": "string"
      },
      "StorageVirtualMachineId": {
        "description": "The ID of the storage virtual machine (SVM) on which to create an SVM-scoped snapshot policy. Specify exactly one of FileSystemId or StorageVirtualMachineId.",
        "maxLength": 21,
        "minLength": 21,
        "pattern": "^(svm-[0-9a-f]{17,})$",
        "type": "string"
      },
      "Tags": {
        "description": "A list of tags to apply to the snapshot policy, with a maximum of 50 tags.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/Tag"
        },
        "maxItems": 50,
        "type": "array",
        "uniqueItems": false
      },
      "UUID": {
        "description": "The UUID of the snapshot policy in ONTAP.",
        "maxLength": 36,
        "pattern": "^[^\\u0000\\u0085\\u2028\\u2029\\r\\n]{1,36}$",
        "type": "string"
      }
    },
    "readOnlyProperties": [
      "/properties/SnapshotPolicyId",
      "/properties/ResourceARN",
      "/properties/Scope",
      "/properties/UUID",
      "/properties/Lifecycle"
    ],
    "required": [
