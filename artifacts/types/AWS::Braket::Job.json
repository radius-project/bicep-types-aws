      "AlgorithmSpecification",
      "DeviceConfig",
      "InstanceConfig",
      "OutputDataConfig",
      "RoleArn"
    ],
    "tagging": {
      "cloudFormationSystemTags": false,
      "permissions": [
        "braket:ListTagsForResource"
      ],
      "tagOnCreate": false,
      "tagProperty": "/properties/Tags",
      "tagUpdatable": false,
      "taggable": true
    },
    "typeName": "AWS::Braket::Job"
  }
