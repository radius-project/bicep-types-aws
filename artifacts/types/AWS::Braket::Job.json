        "$ref": "#/definitions/AlgorithmSpecification"
      },
      "CheckpointConfig": {
        "$ref": "#/definitions/JobCheckpointConfig"
      },
      "CreatedAt": {
        "description": "The time at which the Amazon Braket hybrid job was created.",
        "format": "date-time",
        "type": "string"
      },
      "DeviceConfig": {
        "$ref": "#/definitions/DeviceConfig"
      },
      "HyperParameters": {
        "additionalProperties": false,
        "description": "Algorithm-specific parameters used by an Amazon Braket hybrid job.",
        "maxProperties": 100,
        "patternProperties": {
          "^.{1,256}$": {
            "maxLength": 2500,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "InputDataConfig": {
        "description": "A list of parameters that specify the name and type of input data and where it is located.",
        "items": {
          "$ref": "#/definitions/InputFileConfig"
        },
        "maxItems": 20,
        "minItems": 0,
        "type": "array"
      },
      "InstanceConfig": {
        "$ref": "#/definitions/InstanceConfig"
      },
      "JobArn": {
        "description": "The ARN of the Amazon Braket hybrid job.",
        "pattern": "^arn:aws[a-z\\-]*:braket:[a-z0-9\\-]+:[0-9]{12}:job/.*$",
        "type": "string"
      },
      "JobName": {
        "description": "The name of the Amazon Braket hybrid job.",
        "maxLength": 50,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9](-*[a-zA-Z0-9]){0,50}$",
        "type": "string"
      },
      "OutputDataConfig": {
        "$ref": "#/definitions/JobOutputDataConfig"
      },
      "RoleArn": {
        "description": "The Amazon Resource Name (ARN) of an IAM role that Amazon Braket can assume to perform tasks on behalf of a user.",
        "pattern": "^arn:aws[a-z\\-]*:iam::\\d{12}:role/?[a-zA-Z_0-9+=,.@\\-_/]+$",
        "type": "string"
      },
      "Status": {
        "description": "The status of the Amazon Braket hybrid job.",
        "enum": [
          "QUEUED",
          "RUNNING",
          "COMPLETED",
          "FAILED",
          "CANCELLING",
          "CANCELLED"
        ],
        "type": "string"
      },
      "StoppingCondition": {
        "$ref": "#/definitions/JobStoppingCondition"
      },
      "Tags": {
        "description": "Tags associated with the hybrid job.",
        "insertionOrder": false,
        "items": {
          "$ref": "#/definitions/Tag"
        },
        "type": "array"
      }
    },
    "readOnlyProperties": [
      "/properties/JobArn",
      "/properties/Status",
      "/properties/CreatedAt"
    ],
    "required": [
