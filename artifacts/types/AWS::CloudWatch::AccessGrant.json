    "definitions": {
      "AccessGrantPrincipal": {
        "additionalProperties": false,
        "description": "The principal receiving the grant. Specify PrincipalId, PrincipalAttributes, or both.",
        "properties": {
          "PrincipalAttributes": {
            "description": "Attribute conditions for attribute-based access. When provided, the grant targets any principal matching all specified conditions. Supported only for IDC_USER principals.",
            "insertionOrder": true,
            "items": {
              "$ref": "#/definitions/AccessGrantPrincipalAttribute"
            },
            "maxItems": 10,
            "type": "array",
            "uniqueItems": false
          },
          "PrincipalId": {
            "description": "The ID of the principal receiving the grant. An IAM principal ARN, an Identity Center UUID, or a service-defined identifier.",
            "maxLength": 2048,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:/_+=,.@-]*$",
            "type": "string"
          },
          "PrincipalType": {
            "description": "The type of principal receiving the grant.",
            "enum": [
              "IDC_USER",
              "IDC_GROUP",
              "IAM_USER",
              "IAM_ROLE",
              "IAM_ROOT",
              "ACCESS_PROFILE",
              "ALERT",
              "AGENT"
            ],
            "type": "string"
          }
        },
        "required": [
          "PrincipalType"
        ],
        "type": "object"
      },
      "AccessGrantPrincipalAttribute": {
        "additionalProperties": false,
        "description": "A single attribute condition used to match principals for attribute-based access.",
        "properties": {
          "Key": {
            "description": "The Identity Center user attribute to match on. One of userName, active, userStatus, displayName, email, name.givenName, name.familyName, enterprise.department, enterprise.division, enterprise.organization, enterprise.costCenter, or enterprise.employeeNumber.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "Value": {
            "description": "The attribute value.",
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "Key",
          "Value"
        ],
        "type": "object"
      },
      "ResourceScope": {
        "additionalProperties": false,
        "description": "A single resource scope entry within an access grant. Associates a resource type with optional ARN patterns, tag conditions, and row-level filters.",
        "properties": {
          "ResourceArns": {
            "description": "Specific resource ARNs or ARN patterns. When set, actions are limited to these resources. When absent, defaults to all resources of the type.",
            "insertionOrder": true,
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "type": "array",
            "uniqueItems": false
          },
          "ResourceType": {
            "description": "The resource type name, for example DataSet or OmniDashboard.",
            "type": "string"
          },
          "RowScopeGroups": {
            "description": "Row-level filters for this scope, as an OR of AND-groups: a row is visible when it matches every filter in any one group. Requires SignalTypes.",
            "insertionOrder": true,
            "items": {
              "$ref": "#/definitions/RowScopeGroup"
            },
            "maxItems": 20,
            "minItems": 1,
            "type": "array",
            "uniqueItems": false
          },
          "SignalTypes": {
            "description": "Signal types this scope's row filtering applies to. Required when RowScopeGroups is set.",
            "insertionOrder": false,
            "items": {
              "enum": [
                "LOGS",
                "TRACES"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "Tags": {
            "additionalProperties": false,
            "description": "Tag-based conditions for dynamic resource scoping. Access applies only to resources carrying all of the specified tag key-value pairs.",
            "maxProperties": 3,
            "patternProperties": {
              "^.+$": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "ResourceType"
        ],
        "type": "object"
      },
      "RowScope": {
        "additionalProperties": false,
        "description": "A single additive row-level filter on an access grant. A row is visible when its value for the given field matches the filter's values.",
        "properties": {
          "Field": {
            "description": "The field the allowlist applies to, for example serviceName or accountId.",
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "Operator": {
            "description": "Match operator applied to this filter's values.",
            "enum": [
              "IN"
            ],
            "type": "string"
          },
          "Values": {
            "description": "The values the field is matched against.",
            "insertionOrder": false,
            "items": {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "Field",
          "Operator",
          "Values"
        ],
        "type": "object"
      },
      "RowScopeGroup": {
        "description": "A group of row filters that must all match. A row satisfies the group only when it matches every filter in it.",
        "insertionOrder": true,
        "items": {
          "$ref": "#/definitions/RowScope"
        },
        "maxItems": 20,
        "minItems": 1,
        "type": "array",
        "uniqueItems": false
      },
      "ScopedActions": {
        "additionalProperties": false,
        "description": "A group of actions within an access grant, together with the resource scopes and context conditions that apply to exactly those actions.",
        "properties": {
          "Actions": {
            "description": "The actions this group applies to, each in vendor-code:Action form.",
            "insertionOrder": true,
            "items": {
              "maxLength": 256,
              "minLength": 3,
              "pattern": "^[a-z0-9][a-z0-9-]*:[A-Za-z][A-Za-z0-9]*$",
              "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array",
            "uniqueItems": false
          },
          "ContextConditions": {
            "additionalProperties": false,
            "description": "Context conditions for fine-grained access control on these actions, as a map of condition keys to lists of allowed values.",
            "maxProperties": 10,
            "patternProperties": {
              "^.+$": {
                "insertionOrder": true,
                "items": {
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": false
              }
            },
            "type": "object"
          },
          "Resources": {
            "description": "Resource scopes constraining these actions to specific resources.",
            "insertionOrder": true,
            "items": {
              "$ref": "#/definitions/ResourceScope"
            },
            "maxItems": 10,
            "type": "array",
            "uniqueItems": false
          }
        },
        "required": [
          "Actions"
        ],
        "type": "object"
      },
      "Tag": {
        "additionalProperties": false,
        "description": "A key-value pair to associate with a resource.",
        "properties": {
          "Key": {
            "description": "The key name of the tag.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "Value": {
            "description": "The value for the tag.",
            "maxLength": 256,
            "minLength": 0,
            "type": "string"
          }
        },
        "required": [
          "Key",
          "Value"
        ],
        "type": "object"
      }
