        "maxLength": 256,
        "minLength": 0,
        "pattern": "^[a-zA-Z0-9_:.-]{0,256}$",
        "type": "string"
      },
      "UUID": {
        "description": "The ONTAP UUID of the SnapMirror relationship.",
        "maxLength": 36,
