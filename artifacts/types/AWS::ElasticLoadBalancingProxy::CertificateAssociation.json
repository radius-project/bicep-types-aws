{
  "arn": "arn:aws:cloudformation:us-west-2::type/resource/AWS-ElasticLoadBalancingProxy-CertificateAssociation",
  "type": "AWS::ElasticLoadBalancingProxy::CertificateAssociation",
  "time": "2026-11-25T21:26:53.08Z",
  "schema": {
    "additionalIdentifiers": [
      [
        "/properties/ProxyName",
